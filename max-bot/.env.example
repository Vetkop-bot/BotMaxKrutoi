# Токен бота (выдан организаторами)
BOT_TOKEN=

# Публичный HTTPS-адрес мини-приложения (для справки, привязку делают организаторы)
WEBAPP_URL=

# Подключение к PostgreSQL. В docker-compose задаётся автоматически.
DATABASE_URL=postgres://sportbuddy:sportbuddy@localhost:5432/sportbuddy

# Порт HTTP API
PORT=3000

# Часовой пояс, в котором указывается время встреч
APP_TIMEZONE=Europe/Moscow

# true — разрешить вход без MAX по заголовку X-Dev-User (только для локальной проверки!)
DEV_AUTH=false

# Разрешённые источники для CORS через запятую, если мини-приложение размещено
# на другом домене, например https://vetkop-bot.github.io
CORS_ORIGINS=
